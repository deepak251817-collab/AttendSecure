# Copy this file to .env and fill in real values. Never commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"

FLASK_SECRET_KEY=replace-with-a-secure-secret
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=attendance
MYSQL_USER=root
MYSQL_PASSWORD=

# Dedicated test database used by pytest (kept separate from dev data)
TEST_MYSQL_DATABASE=attendance_test

# Optional tuning
# MAX_UPLOAD_MB=5
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# LOW_ATTENDANCE_THRESHOLD=75
# QR_SESSION_MINUTES=5

# Session cookie Secure flag. Defaults: development/testing -> off,
# production -> ON. Set to 0 only for a local HTTP-only demo (e.g. Docker
# compose on localhost); set to 1 when serving behind HTTPS.
SESSION_COOKIE_SECURE=0

# Docker compose: root password for the MySQL container and the host port
# it is published on (3306 is often taken by a local MySQL install).
MYSQL_ROOT_PASSWORD=replace-with-a-secure-root-password
MYSQL_EXPOSE_PORT=3307

# Only used by reset_db.py / seed_demo.py for unattended setup
# ADMIN_PASSWORD=
